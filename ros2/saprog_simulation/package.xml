<?xml version="1.0"?>
<package format="3">
  <name>saprog_simulation</name>
  <version>0.1.0</version>
  <description>On-demand, lightweight Gazebo Harmonic simulation for Saprog.</description>
  <maintainer email="pausolsonaboada@gmail.com">Pau Solsona Boada</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>gz_sim_vendor</exec_depend>
  <exec_depend>gz_transport_vendor</exec_depend>
  <exec_depend>gz_msgs_vendor</exec_depend>
  <exec_depend>sdformat_vendor</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
