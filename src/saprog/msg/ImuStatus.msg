bool connected
bool streaming
bool orientation_valid
bool zeroed
bool calibrating
bool calibrated
bool magnetic_heading
bool correcting_tilt
string device
uint32 baud_rate
string[] ports
string message
string calibration_message
uint64 sample_count
uint64 invalid_lines
uint64 time_gaps
float64 sensor_time_ms
float64 sample_hz
float64 peak_gyro_dps
float64[3] gyro_bias_dps
