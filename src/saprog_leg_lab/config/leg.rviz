Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: Leg geometry (independent joints, closure unsolved)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /saprog/leg_lab/robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: Pivot frames
      Enabled: true
      Show Axes: true
      Show Arrows: false
      Show Names: true
      Marker Scale: 0.15
  Enabled: true
  Global Options:
    Background Color: 29; 41; 57
    Fixed Frame: base
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.55
      Focal Point:
        X: 0.05
        Y: -0.09
        Z: -0.08
      Near Clip Distance: 0.001
      Pitch: 0.35
      Yaw: 0.9
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1100
  Height: 750
