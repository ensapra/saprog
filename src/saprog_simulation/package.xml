<?xml version="1.0"?>
<package format="3">
  <name>saprog_simulation</name>
  <version>0.1.0</version>
  <description>Whole-robot Gazebo physics and snapshot playback for Saprog.</description>
  <maintainer email="pausolsonaboada@gmail.com">Pau Solsona Boada</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <exec_depend>gz_transport_vendor</exec_depend>
  <exec_depend>gz_msgs_vendor</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>saprog_description</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
